---
import BaseLayout from '../layouts/BaseLayout.astro';

const semesters = [
  {
    label: 'Spring 2026',
    courses: [
      { code: 'CS112', title: 'Introduction to Data Structures', url: 'https://ericaraujo.com/26sp-cs112/', desc: 'Fundamental data structures and algorithms.' },
      { code: 'CS214', title: 'Concepts of Programming Languages', url: 'https://ericaraujo.com/26sp-cs214/', desc: 'Comparative study of programming language paradigms.' },
      { code: 'CS354A', title: 'Database Management Systems', url: 'https://ericaraujo.com/26sp-cs354a/', desc: 'Introduction to database design and management.' },
    ],
  },
  {
    label: 'Fall 2025',
    courses: [
      { code: 'CS112', title: 'Introduction to Data Structures', url: 'https://ericaraujo.com/25fa-cs112/', desc: 'Fundamental data structures and algorithms.' },
      { code: 'HNRS251', title: 'Social Computing', url: 'https://ericaraujo.com/socialmodeling/', desc: 'Honors course exploring computational social science.' },
    ],
  },
  {
    label: 'Spring 2025',
    courses: [
      { code: 'CS112', title: 'Introduction to Data Structures', url: 'https://ericaraujo.com/25sp-cs112/', desc: 'Fundamental data structures and algorithms.' },
      { code: 'CS354A', title: 'Database Management Systems', url: 'https://ericaraujo.com/25sp-cs354A/', desc: 'Introduction to database design and management.' },
    ],
  },
  {
    label: 'Fall 2024',
    courses: [
      { code: 'CS112', title: 'Introduction to Data Structures', url: 'https://ericaraujo.com/24fa-cs112/', desc: 'Fundamental data structures and algorithms.' },
      { code: 'CS300b', title: 'Agent Modeling', url: 'https://ericaraujo.com/24fa-cs300b/', desc: 'Agent-based modeling and simulation, with opportunities to contribute to active research projects.' },
    ],
  },
];
---

<BaseLayout title="Teaching">
  <div class="page-wrapper">

    <div class="page-header">
      <h1>Teaching</h1>
      <p>
        "Tell me and I forget. Teach me and I remember. Involve me and I learn." — Benjamin Franklin
      </p>
    </div>

    <p style="margin-bottom: 2rem; color: var(--text-muted); font-size: 14px; max-width: 640px;">
      I believe in hands-on learning and real-world applications. My courses emphasise practical
      problem-solving, collaborative work, and connecting theory to current challenges.
      Prerequisites, office hours, and course materials are posted on individual course sites.
      For educators interested in adapting my materials,
      <a href="mailto:eric.araujo@calvin.edu">email me</a>.
    </p>

    <ul class="semester-list">
      {semesters.map((sem, i) => (
        <li>
          <details class="semester" open={i === 0 || undefined}>
            <summary>{sem.label}</summary>
            <div class="semester-content">
              {sem.courses.map(c => (
                <div class="course-item">
                  <span class="course-code">{c.code}</span>
                  <p class="course-title"><a href={c.url} target="_blank">{c.title}</a></p>
                  <p class="course-desc">{c.desc}</p>
                </div>
              ))}
            </div>
          </details>
        </li>
      ))}
    </ul>

  </div>
</BaseLayout>
