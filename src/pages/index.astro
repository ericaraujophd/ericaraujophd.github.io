---
import BaseLayout from '../layouts/BaseLayout.astro';
import news from '../../data/publications.json';  // for recent activity; swap with news.json if separate

import grants from '../../data/grants.json';
import presentations from '../../data/presentations.json';
import service from '../../data/service.json';

// Combine recent news-eligible items and take top 6
type NewsItem = { date: string; title: string; url?: string; label: string };

const recentGrants = (grants as any[])
  .filter(g => g.news && g.visible_web)
  .map(g => ({ date: g.start_date.includes('-') ? `${g.start_date}-01` : `${g.start_date}-01-01`, title: g.name, url: g.url, label: 'Fellowship / Award' }));

const recentTalks = (presentations as any[])
  .filter(p => p.news && p.visible_web)
  .map(p => ({ date: p.date, title: p.title, url: p.url, label: 'Presentation' }));

const recentPubs = (news as any[])
  .filter(p => p.news && p.visible_web)
  .map(p => ({ date: `${p.year}-01-01`, title: p.title, url: p.url, label: 'Publication' }));

const recentService = (service as any[])
  .filter(s => s.news && s.visible_web)
  .map(s => ({ date: s.date, title: s.title, url: s.url ?? undefined, label: 'Service' }));

const allNews: NewsItem[] = [...recentGrants, ...recentTalks, ...recentPubs, ...recentService]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="hero">
    <p class="hero-meta">Associate Professor — Computer Science — Calvin University</p>
    <h1 class="hero-name">Eric<br>Araújo</h1>
    <div class="hero-rule"></div>
    <p class="hero-desc">
      Olá! I use computational methods to understand how behaviours, opinions, and sentiments
      spread through societies — through <strong>multiagent modeling and simulation</strong>.
      My current work centers on the <strong>computational modeling of Christian and religious
      communities</strong>, alongside ongoing research in crime and urban networks, political
      polarization, and public health.
    </p>
    <div class="hero-links">
      <a href="mailto:eric.araujo@calvin.edu">Email</a>
      <a href="/cv/Eric_Araujo_CV.pdf" class="primary">CV ↓</a>
      <a href="https://scholar.google.com/citations?user=QlE8JOoAAAAJ&hl=en&authuser=1" target="_blank">Scholar ↗</a>
      <a href="https://orcid.org/0000-0003-4263-9075" target="_blank">ORCID ↗</a>
      <a href="http://lattes.cnpq.br/8108200264338612" target="_blank">Lattes ↗</a>
      <a href="https://www.youtube.com/EricAra%C3%BAjo" target="_blank">YouTube ↗</a>
    </div>
  </section>

  <!-- Bento grid -->
  <div class="bento">

    <!-- Projects -->
    <div class="bento-card bento-projects fade-up" data-delay="0">
      <span class="bento-label">Projects</span>
      <div class="project-grid">

        <a href="/matristics" target="_blank" rel="noopener" class="project-card">
          <span class="project-tag">LLM Evaluation · Early Church</span>
          <h3 class="project-name">Matristics</h3>
          <p class="project-desc">
            How well do frontier language models know the women who shaped Christianity's
            first five centuries? A benchmark of six models across accuracy, framing, and
            the silences they inherit.
          </p>
          <span class="project-go">ericaraujo.com/matristics ↗</span>
        </a>

        <a href="https://csprayers.com" target="_blank" rel="noopener" class="project-card">
          <span class="project-tag">Faith &amp; Computing</span>
          <h3 class="project-name">CS Prayers</h3>
          <p class="project-desc">
            A Book of Hours for Computing — prayers for those who study, teach, and
            practice computer science. For first days and finals week, for debugging
            and deploying.
          </p>
          <span class="project-go">csprayers.com ↗</span>
        </a>

      </div>
    </div>

    <!-- Recent News -->
    <div class="bento-card bento-news fade-up" data-delay="1">
      <span class="bento-label">Recent News</span>
      {allNews.map(item => (
        <div class="news-item">
          <span class="news-date">{fmtDate(item.date)} — {item.label}</span>
          <p class="news-title">
            {item.url
              ? <a href={item.url} target="_blank">{item.title}</a>
              : item.title
            }
          </p>
        </div>
      ))}
      <a href="/updates" class="news-all">All updates →</a>
    </div>

    <!-- Formation -->
    <div class="bento-card bento-formation fade-up" data-delay="2">
      <span class="bento-label">Formation</span>
      <div class="degree">
        <div class="degree-level">Ph.D.</div>
        <div class="degree-school">
          <a href="https://vu.nl/nl" target="_blank">Vrije Universiteit Amsterdam</a> · 2018
        </div>
        <p class="degree-note">Computational modeling of social contagion</p>
      </div>
      <div class="degree">
        <div class="degree-level">M.S.</div>
        <div class="degree-school">
          <a href="https://ufmg.br/" target="_blank">UFMG, Brazil</a> · 2009
        </div>
      </div>
      <div class="degree">
        <div class="degree-level">B.S.</div>
        <div class="degree-school">
          <a href="https://www.ufv.br/" target="_blank">UFV, Brazil</a> · 2007
        </div>
      </div>
    </div>

    <!-- Research -->
    <div class="bento-card bento-research fade-up" data-delay="3">
      <span class="bento-label">Research &amp; Scholarship</span>
      <p style="color: var(--text-muted); font-size: 15px;">
        My work bridges computer science and the social sciences, applying agent-based modeling
        and complex network analysis to questions of social dynamics. My current focus is the
        computational modeling of Christian and religious communities — including church
        polarization and the dynamics of faith communities — supported by the Calvin Research
        Fellowship and a Nagel Institute Fellowship. A complementary thread applies AI and
        large language models to early Christian texts to recover and better understand the
        lives and roles of women in the early church. Continuing threads include crime
        network topology and urban structure, political opinion formation, and epidemiological
        behaviour spread.
      </p>
      <p style="color: var(--text-muted); font-size: 15px;">
        Core methodologies: agent-based modeling and simulation, complex network analysis,
        social dynamics modeling, cognitive behavioural frameworks, machine learning.
      </p>
      <p style="margin-top: 1rem; font-size: 15px;">
        <a href="https://scholar.google.com/citations?user=QlE8JOoAAAAJ" target="_blank">Google Scholar</a>
        · <a href="https://orcid.org/0000-0003-4263-9075" target="_blank">ORCID</a>
        · <a href="/files/Contagious_Eric_Araujo.pdf">PhD thesis</a>
      </p>
    </div>

    <!-- Quote -->
    <div class="bento-card bento-quote fade-up" data-delay="4">
      <blockquote>
        <p>There is not a square inch in the whole domain of our human existence over which Christ, who is Sovereign over all, does not cry: &#x2018;Mine!&#x2019;</p>
        <footer>— Abraham Kuyper</footer>
      </blockquote>
    </div>

  </div>

</BaseLayout>
