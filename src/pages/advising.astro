---
import BaseLayout from '../layouts/BaseLayout.astro';
import students from '../../data/students.json';

interface Student {
  id: string;
  names: string[];
  degree: 'Ph.D.' | 'M.S.' | 'B.S.' | 'Undergraduate';
  institution: string;
  project: string;
  project_en?: string;
  start: string;
  end: string | null;
  outcomes: string[];
  doi?: string;
  visible_web: boolean;
  // Optional per-person profile links, keyed by the exact string used in
  // `names` (e.g. { "Katelin Jandris": "https://www.linkedin.com/in/..." }).
  // Names without an entry render as plain text. Website only: the CV
  // pipeline (scripts/to_rendercv.py) ignores this field.
  links?: Record<string, string>;
}

const all = (students as Student[]).filter(s => s.visible_web);

// ── Current vs past ─────────────────────────────────────────────────────────
// A student is "current" until the term in `end` is over, not merely when
// `end` is empty. Senior projects are entered with their planned end term
// ("Fall 2026" to "Spring 2027") the day they start, so an empty-`end` rule
// would file them under Past Students from day one.
//
// Terms are strings like "Fall 2026", "Summer 2026" or a bare year "2022".
// Each maps to the last day of that term, roughly: Spring ends 31 May, Summer
// 31 Aug, Fall 31 Dec, Interim/Winter 31 Jan; a bare year ends 31 Dec. The
// comparison uses UTC so the build gives the same answer on any machine.
//
// The site is static, so this is evaluated at build time: a project rolls
// from Current to Past on the first rebuild after its end term, not on the
// day itself. Pushing anything to master rebuilds the site.
const TERM_END_MONTH: Record<string, number> = { Interim: 1, Winter: 1, Spring: 5, Summer: 8, Fall: 12 };
const termEnd = (t: string): Date | null => {
  const m = t.match(/^(Interim|Winter|Spring|Summer|Fall)?\s*(\d{4})$/);
  if (!m) return null;
  const month = m[1] ? TERM_END_MONTH[m[1]] : 12;
  // Day 0 of the next month is the last day of `month`.
  return new Date(Date.UTC(Number(m[2]), month, 0));
};
const today = new Date();
const isCurrent = (s: Student) => {
  if (!s.end || s.end === 'present') return true;
  const end = termEnd(s.end);
  return end !== null && end >= today;
};
// ── Ordering ────────────────────────────────────────────────────────────────
// Both lists run newest first by start term, so the order does not depend on
// where an entry happens to sit in students.json. Terms map to a first day:
// Interim/Winter Jan, Spring Jan, Summer Jun, Fall Sep; a bare year is Jan.
// Ties (same start) fall back to the later end term first.
// A one-term project (start == end) prints its term once in the lists below.
const TERM_START_MONTH: Record<string, number> = { Interim: 0, Winter: 0, Spring: 0, Summer: 5, Fall: 8 };
const termStart = (t: string): number => {
  const m = t.match(/^(Interim|Winter|Spring|Summer|Fall)?\s*(\d{4})$/);
  if (!m) return 0;
  return Date.UTC(Number(m[2]), m[1] ? TERM_START_MONTH[m[1]] : 0, 1);
};
const endKey = (s: Student) => (!s.end || s.end === 'present') ? Infinity : (termEnd(s.end)?.getTime() ?? 0);
const newestFirst = (a: Student, b: Student) =>
  termStart(b.start) - termStart(a.start) || endKey(b) - endKey(a);

const current = all.filter(isCurrent).sort(newestFirst);
const past    = all.filter(s => !isCurrent(s)).sort(newestFirst);

const byDegree = (list: Student[], degree: string) =>
  list.filter(s => s.degree === degree);

const degrees = ['Ph.D.', 'M.S.', 'B.S.'];

// Each name becomes { name, url } so the template can link the ones that have
// a URL in `links` and print the rest as plain text. (Astro frontmatter is plain
// TypeScript, so the markup itself lives in the template below, not here.)
const nameParts = (s: Student) => s.names.map(n => ({ name: n, url: s.links?.[n] }));
---

<BaseLayout title="Advising">
  <div class="page-wrapper">

    <div class="page-header fade-up" data-delay="0">
      <h1>Advising</h1>
      <div style="width: 36px; height: 2px; background: var(--accent); margin: 10px 0 16px;"></div>
      <p>
        I enjoy mentoring students at different stages of their academic journey — from first
        research experiences through graduate-level work. Students in my group work on problems
        in agent-based modeling, complex networks, social computing, machine learning, and
        computational modeling of human behavior.
      </p>
    </div>

    {current.length > 0 && (
      <section class="fade-up" data-delay="1" style="margin-bottom: 3rem;">
        <h2>Current Students</h2>
        <ul class="pub-list">
          {current.map(s => (
            <li class="pub-item">
              <span class="pub-type-tag">{s.degree}</span>
              <div class="pub-content">
                <p class="pub-title">{nameParts(s).map((n, i) => (
                  <Fragment>{i > 0 && ', '}{n.url
                    ? <a href={n.url} target="_blank" rel="noopener noreferrer">{n.name}</a>
                    : n.name}</Fragment>
                ))}</p>
                <p class="pub-authors">
                  {s.project_en
                    ? <span title={s.project_en} class="has-translation">{s.project}</span>
                    : s.project
                  }
                </p>
                <p class="pub-venue">{s.institution} · {s.start}–{s.end && s.end !== 'present' ? s.end : 'present'}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="fade-up" data-delay="2">
      <h2>Past Students</h2>
      {degrees.map(deg => {
        const group = byDegree(past, deg);
        if (!group.length) return null;
        return (
          <div style="margin-bottom: 2.5rem;">
            <p class="pub-year-heading">{deg} Students</p>
            <ul class="pub-list">
              {group.map(s => (
                <li class="pub-item">
                  <span class="pub-type-tag">{(s.start.match(/\d{4}/) || [s.start])[0]}</span>
                  <div class="pub-content">
                    <p class="pub-title">{nameParts(s).map((n, i) => (
                  <Fragment>{i > 0 && ', '}{n.url
                    ? <a href={n.url} target="_blank" rel="noopener noreferrer">{n.name}</a>
                    : n.name}</Fragment>
                ))}</p>
                    <p class="pub-authors">
                      {s.project_en
                        ? <span title={s.project_en} class="has-translation">{s.project}</span>
                        : s.project
                      }
                    </p>
                    <p class="pub-venue">{s.institution} · {s.end === s.start ? s.start : `${s.start}–${s.end}`}</p>
                    {s.outcomes.length > 0 && (
                      <ul style="margin-top: 4px; padding-left: 16px; font-size: 12px; color: var(--accent);">
                        {s.outcomes.map(o => <li>{o}</li>)}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>

  </div>
</BaseLayout>
