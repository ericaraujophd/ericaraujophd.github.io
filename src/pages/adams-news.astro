---
import BaseLayout from '../layouts/BaseLayout.astro';
import items from '../../data/adams-news.json';

interface NewsItem {
  id: string;
  date_sent: string;
  sender: string;
  email_subject?: string;
  note?: string;
  title: string;
  url: string;
  source: string;
  byline?: string;
  article_date?: string;
  summary: string;
  tags: string[];
  archived?: string[];
  /** 'excerpt' = opening paragraphs only (copyrighted source); 'full' = whole text. */
  archive_type?: 'excerpt' | 'full';
}

const all = (items as NewsItem[])
  .slice()
  .sort((a, b) => new Date(b.date_sent).getTime() - new Date(a.date_sent).getTime());

const tags = [...new Set(all.flatMap(i => i.tags))].sort();

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });

const years = [...new Set(all.map(i => new Date(i.date_sent).getUTCFullYear()))];

// Everything a search query should be able to match against.
const haystack = (i: NewsItem) =>
  [i.title, i.summary, i.note ?? '', i.source, i.byline ?? '', i.tags.join(' '), (i.archived ?? []).join(' ')]
    .join(' ')
    .toLowerCase();
---

<BaseLayout
  title="Adams' News"
  description="A personal archive of articles shared by Prof. Joel Adams."
  noindex
>
  <div class="page-wrapper">

    <div class="page-header fade-up" data-delay="0">
      <h1>Adams' News</h1>
      <div style="width: 36px; height: 2px; background: var(--accent); margin: 10px 0 16px;"></div>
      <p>
        Prof. Joel Adams has a long habit of forwarding articles worth reading — on AI risk,
        the computing job market, and where the discipline is heading. This is my archive of
        them, kept so I can find one again months later. Each entry keeps his own note, a short
        summary, and an opening excerpt; the full article stays with its publisher, one click away.
      </p>
    </div>

    <!-- ---------- Search + filters ---------- -->
    <div class="an-controls fade-up" data-delay="1">
      <div class="an-search-wrap">
        <span class="an-search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          id="an-search"
          class="an-search"
          placeholder="Search titles, summaries, tags, full text…"
          autocomplete="off"
          aria-label="Search Adams' News"
        />
        <kbd class="an-kbd">/</kbd>
      </div>

      <div class="an-tagbar" role="group" aria-label="Filter by topic">
        <button class="an-tag-btn is-active" data-tag="*">All</button>
        {tags.map(t => <button class="an-tag-btn" data-tag={t}>{t}</button>)}
      </div>

      <p class="an-count" id="an-count" aria-live="polite"></p>
    </div>

    <!-- ---------- Entries ---------- -->
    <div id="an-list">
      {years.map(year => (
        <section class="an-year-section" data-year={year}>
          <p class="pub-year-heading">{year}</p>

          {all.filter(i => new Date(i.date_sent).getUTCFullYear() === year).map(item => (
            <article
              class="an-card"
              data-tags={item.tags.join('|')}
              data-search={haystack(item)}
            >
              <div class="an-meta">
                <span class="an-source">{item.source}</span>
                <span class="an-dot">·</span>
                <span class="an-date">Sent {fmtDate(item.date_sent)}</span>
                {item.article_date && item.article_date !== item.date_sent.slice(0, 10) && (
                  <>
                    <span class="an-dot">·</span>
                    <span class="an-date an-date-pub">published {fmtDate(item.article_date)}</span>
                  </>
                )}
              </div>

              <h2 class="an-title">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="an-title-text">{item.title}</span><span class="an-ext"> ↗</span>
                </a>
              </h2>

              {item.note
                ? (
                  <blockquote class="an-note">
                    <p>{item.note}</p>
                    <cite>— {item.sender}</cite>
                  </blockquote>
                )
                : <p class="an-nonote">Forwarded by {item.sender} without comment.</p>
              }

              <p class="an-summary">{item.summary}</p>

              <div class="an-tags">
                {item.tags.map(t => <button class="an-tag" data-tag={t}>{t}</button>)}
              </div>

              {item.archived && item.archived.length > 0 && (
                <details class="an-archive">
                  <summary>
                    <span class="an-archive-label">
                      {item.archive_type === 'full' ? 'Full text' : 'Excerpt'}
                    </span>
                    <span class="an-archive-hint">
                      {item.archive_type === 'full'
                        ? `${item.archived.filter(p => !p.startsWith('## ')).length} paragraphs`
                        : 'opening paragraphs'}
                    </span>
                  </summary>
                  <div class="an-archive-body">
                    {item.archived.map(p =>
                      p.startsWith('## ')
                        ? <h3 class="an-archive-h">{p.slice(3)}</h3>
                        : <p>{p}</p>
                    )}

                    {item.archive_type === 'full' ? (
                      <p class="an-archive-src">
                        Published by <a href={item.url} target="_blank" rel="noopener noreferrer">{item.source}</a>
                        {item.byline && ` · ${item.byline}`}.
                      </p>
                    ) : (
                      <p class="an-archive-src">
                        <a class="an-continue" href={item.url} target="_blank" rel="noopener noreferrer">
                          Continue reading at {item.source} ↗
                        </a>
                        <span class="an-archive-note">
                          Excerpt only{item.byline && ` · ${item.byline}`} — the article belongs to its publisher.
                        </span>
                      </p>
                    )}
                  </div>
                </details>
              )}
            </article>
          ))}
        </section>
      ))}
    </div>

    <p class="an-empty" id="an-empty" hidden>
      Nothing matches that search. <button class="an-reset" id="an-reset">Clear filters</button>
    </p>

  </div>
</BaseLayout>

<style>
  /* ---------- Controls ---------- */
  .an-controls {
    position: sticky;
    /* Sit directly below the sticky navbar; the exact height is measured in JS. */
    top: var(--an-nav-h, 64px);
    scroll-margin-top: calc(var(--an-nav-h, 64px) + 8px);
    z-index: 20;
    background: var(--bg);
    padding: 14px 0 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .an-search-wrap { position: relative; display: flex; align-items: center; }

  .an-search-icon {
    position: absolute;
    left: 14px;
    font-size: 18px;
    color: var(--text-muted);
    pointer-events: none;
    line-height: 1;
  }

  .an-search {
    width: 100%;
    padding: 12px 46px 12px 40px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 300;
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border-mid);
    border-radius: 6px;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .an-search::placeholder { color: var(--text-muted); }
  .an-search:focus { border-color: var(--accent); background: var(--bg-hover); }
  .an-search::-webkit-search-cancel-button { filter: grayscale(1) opacity(0.6); cursor: pointer; }

  .an-kbd {
    position: absolute;
    right: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--border-mid);
    border-radius: 4px;
    padding: 1px 7px;
    pointer-events: none;
  }
  .an-search:focus ~ .an-kbd { opacity: 0; }

  .an-tagbar {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }

  .an-tag-btn {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border-mid);
    border-radius: 999px;
    padding: 4px 12px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .an-tag-btn:hover { color: var(--text); border-color: var(--text-muted); }
  .an-tag-btn.is-active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .an-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    margin: 10px 0 0;
    letter-spacing: 0.03em;
  }

  /* ---------- Cards ---------- */
  .an-year-section { margin-top: 34px; }
  .an-year-section[hidden] { display: none; }

  .an-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 22px 24px;
    margin-bottom: 14px;
    transition: border-color 0.18s, background 0.18s, transform 0.18s;
  }
  .an-card:hover { border-color: var(--border-mid); background: var(--bg-hover); }
  .an-card[hidden] { display: none; }

  .an-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    margin-bottom: 9px;
  }
  .an-source { color: var(--accent); text-transform: uppercase; font-weight: 500; }
  .an-dot { color: var(--text-dim); }
  .an-date { color: var(--text-muted); }
  .an-date-pub { color: var(--text-dim); }

  .an-title {
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    border: none;
    color: var(--text);
    margin: 0 0 12px;
    padding: 0;
  }
  .an-title a { color: var(--text); }
  .an-title a:hover { color: var(--accent); opacity: 1; }
  .an-ext { font-size: 0.8em; color: var(--text-dim); }

  .an-note {
    border-left: 2px solid var(--accent);
    padding: 2px 0 2px 14px;
    margin: 0 0 14px;
  }
  .an-note p {
    font-size: 14.5px;
    font-style: italic;
    color: var(--text);
    margin: 0 0 3px;
    line-height: 1.6;
  }
  .an-note cite {
    font-family: var(--mono);
    font-style: normal;
    font-size: 10.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .an-nonote {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin: 0 0 14px;
  }

  .an-summary {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .an-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .an-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border-mid);
    border-radius: 3px;
    padding: 2px 8px;
    transition: color 0.15s, border-color 0.15s;
  }
  .an-tag:hover { color: var(--accent); border-color: var(--accent); }

  /* ---------- Archived text ---------- */
  .an-archive {
    margin-top: 16px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }
  .an-archive summary {
    display: flex;
    align-items: baseline;
    gap: 9px;
    cursor: pointer;
    list-style: none;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .an-archive summary::-webkit-details-marker { display: none; }
  .an-archive summary:hover { color: var(--accent); }
  .an-archive-label::before { content: '▸ '; }
  .an-archive[open] .an-archive-label::before { content: '▾ '; }
  .an-archive-hint { color: var(--text-dim); text-transform: none; letter-spacing: 0; font-size: 10.5px; }

  .an-archive-body {
    margin-top: 14px;
    padding-left: 14px;
    border-left: 1px solid var(--border-mid);
    max-height: 460px;
    overflow-y: auto;
  }
  .an-archive-body p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .an-archive-h {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text);
    margin: 1.4rem 0 0.6rem;
  }
  .an-archive-src {
    font-size: 11.5px !important;
    color: var(--text-dim) !important;
    border-top: 1px solid var(--border);
    padding-top: 10px;
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .an-continue {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--accent);
    white-space: nowrap;
  }

  .an-archive-note { color: var(--text-dim); }

  /* ---------- Empty state ---------- */
  .an-empty {
    font-size: 14.5px;
    color: var(--text-muted);
    text-align: center;
    padding: 48px 0;
  }
  .an-reset {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    background: none;
    border: none;
    border-bottom: 1px solid var(--accent);
    padding: 0;
  }

  /* ---------- Search highlight ---------- */
  :global(mark.an-hit) {
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    color: var(--text);
    border-radius: 2px;
    padding: 0 1px;
  }

  @media (max-width: 640px) {
    .an-card { padding: 18px 16px; }
    .an-kbd { display: none; }

    /* Fourteen wrapped tag pills would eat a third of a phone screen, and the
       bar is sticky — keep it to one swipeable row instead. */
    .an-tagbar {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 2px;
      -webkit-overflow-scrolling: touch;
    }
    .an-tagbar::-webkit-scrollbar { display: none; }
    .an-tag-btn { flex: 0 0 auto; }
  }
</style>

<script>
  const search  = document.getElementById('an-search') as HTMLInputElement | null;
  const countEl = document.getElementById('an-count');
  const emptyEl = document.getElementById('an-empty');
  const resetEl = document.getElementById('an-reset');
  const cards   = Array.from(document.querySelectorAll<HTMLElement>('.an-card'));
  const years   = Array.from(document.querySelectorAll<HTMLElement>('.an-year-section'));
  const tagBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.an-tag-btn'));

  // Keep the sticky control bar parked just under the sticky navbar.
  const nav = document.querySelector<HTMLElement>('.navbar');
  const measureNav = () =>
    document.documentElement.style.setProperty('--an-nav-h', `${nav?.offsetHeight ?? 64}px`);
  measureNav();
  window.addEventListener('resize', measureNav);

  let activeTag = '*';

  // Cache the original text of every highlightable field once, so repeated
  // searches never compound their own <mark> tags.
  const HL_SELECTOR = '.an-title-text, .an-summary, .an-note p';
  const hlFields = cards.flatMap(card =>
    Array.from(card.querySelectorAll<HTMLElement>(HL_SELECTOR)).map(el => ({
      el,
      text: el.textContent ?? '',
    }))
  );

  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  const highlight = (terms: string[]) => {
    for (const { el, text } of hlFields) {
      if (terms.length === 0) {
        el.textContent = text;
        continue;
      }
      const re = new RegExp(`(${terms.map(escapeRe).join('|')})`, 'gi');
      el.innerHTML = escapeHtml(text).replace(re, '<mark class="an-hit">$1</mark>');
    }
  };

  const apply = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    highlight(terms);
    let shown = 0;

    for (const card of cards) {
      const hay  = card.dataset.search ?? '';
      const tags = (card.dataset.tags ?? '').split('|');

      const matchesTag  = activeTag === '*' || tags.includes(activeTag);
      const matchesText = terms.every(t => hay.includes(t));
      const visible     = matchesTag && matchesText;

      card.hidden = !visible;
      if (visible) shown++;
    }

    // Hide a year heading when every card under it is filtered out.
    for (const section of years) {
      const any = Array.from(section.querySelectorAll<HTMLElement>('.an-card')).some(c => !c.hidden);
      section.hidden = !any;
    }

    if (countEl) {
      countEl.textContent =
        shown === cards.length
          ? `${cards.length} ${cards.length === 1 ? 'article' : 'articles'}`
          : `${shown} of ${cards.length} ${cards.length === 1 ? 'article' : 'articles'}`;
    }
    if (emptyEl) emptyEl.hidden = shown !== 0;
  };

  search?.addEventListener('input', apply);

  for (const btn of tagBtns) {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag ?? '*';
      tagBtns.forEach(b => b.classList.toggle('is-active', b === btn));
      apply();
    });
  }

  // Tag pills inside a card select that tag in the filter bar.
  document.querySelectorAll<HTMLButtonElement>('.an-tag').forEach(pill => {
    pill.addEventListener('click', () => {
      const target = tagBtns.find(b => b.dataset.tag === pill.dataset.tag);
      target?.click();
      document.querySelector('.an-controls')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  resetEl?.addEventListener('click', () => {
    if (search) search.value = '';
    tagBtns.find(b => b.dataset.tag === '*')?.click();
    search?.focus();
  });

  // "/" focuses the search box; Escape clears it.
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') {
      e.preventDefault();
      search?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === search) {
      if (search) search.value = '';
      apply();
      search?.blur();
    }
  });

  apply();
</script>
