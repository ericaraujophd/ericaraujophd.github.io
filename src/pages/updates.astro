---
import BaseLayout from '../layouts/BaseLayout.astro';
import publications from '../../data/publications.json';
import grants from '../../data/grants.json';
import presentations from '../../data/presentations.json';
import service from '../../data/service.json';

// Dates in data/*.json are either ISO-ish ("2026", "2026-08", "2026-08-19") or a
// term string ("Summer 2026"). V8 silently coerces "Summer 2026" to Jan 1, so both
// parsing and formatting have to be explicit about which kind they are handling.
const TERM_MONTH: Record<string, string> = { Spring: '03', Summer: '06', Fall: '09', Winter: '12' };
const isIso = (d: string) => /^\d{4}(-\d{2}){0,2}$/.test(d);
const toDate = (d: string) => {
  if (isIso(d)) return new Date(d);
  const m = d.match(/^(Spring|Summer|Fall|Winter)\s+(\d{4})$/);
  return m ? new Date(`${m[2]}-${TERM_MONTH[m[1]]}`) : new Date(d);
};

// Aggregate all news-visible items into a unified timeline
type Entry = { date: string; label: string; title: string; url?: string; body?: string };

const pubEntries: Entry[] = (publications as any[])
  .filter(p => p.news && p.visible_web)
  .map(p => ({
    date: p.month ? `${p.year}-${String(p.month).padStart(2,'0')}` : `${p.year}`,
    label: 'Publication',
    title: p.title,
    url: p.url,
    body: `${p.venue}, ${p.year}.`,
  }));

const grantEntries: Entry[] = (grants as any[])
  .filter(g => g.news && g.visible_web)
  .map(g => ({
    date: g.start_date,
    label: 'Fellowship / Award',
    title: g.name,
    url: g.url,
    body: g.summary,
  }));

const presEntries: Entry[] = (presentations as any[])
  .filter(p => p.news && p.visible_web)
  .map(p => ({
    date: p.date,
    label: 'Presentation',
    title: p.title,
    url: p.url,
    body: `${p.event}. ${p.location}.`,
  }));

const serviceEntries: Entry[] = (service as any[])
  .filter(s => s.news && s.visible_web)
  .map(s => ({
    date: s.date ?? s.start_date,
    label: 'Service',
    title: s.title,
    url: s.url ?? undefined,
    body: s.summary,
  }));

const all = [...pubEntries, ...grantEntries, ...presEntries, ...serviceEntries]
  .sort((a, b) => toDate(b.date).getTime() - toDate(a.date).getTime());

const years = [...new Set(all.map(e => toDate(e.date).getUTCFullYear()))];


const fmtDate = (d: string) => {
  if (!isIso(d)) return d;          // print "Summer 2026" verbatim
  const opts: Intl.DateTimeFormatOptions = { timeZone: 'UTC', year: 'numeric' };
  if (d.length >= 7) opts.month = 'long';
  if (d.length >= 10) opts.day = 'numeric';
  return new Date(d).toLocaleDateString('en-US', opts);
};
---

<BaseLayout title="Updates" description="Recent news and updates from Eric Araújo.">
  <div class="page-wrapper">

    <div class="page-header fade-up" data-delay="0">
      <h1>News &amp; Updates</h1>
      <div style="width: 36px; height: 2px; background: var(--accent); margin: 10px 0 16px;"></div>
      <p>Recent activity — publications, fellowships, presentations, and service.</p>
    </div>

    {years.map((year, i) => (
      <section class="pub-year-section fade-up" data-delay={i === 0 ? 1 : 0}>
        <p class="pub-year-heading">{year}</p>
        <ul class="pub-list">
          {all.filter(e => toDate(e.date).getUTCFullYear() === year).map(entry => (
            <li class="pub-item">
              <span class="pub-type-tag">{entry.label.split(' ')[0].toUpperCase().slice(0,4)}</span>
              <div class="pub-content">
                <p class="pub-title">
                  {entry.url
                    ? <a href={entry.url} target="_blank">{entry.title}</a>
                    : entry.title
                  }
                </p>
                {entry.body && <p class="pub-authors">{entry.body}</p>}
                <p class="pub-venue">{fmtDate(entry.date)}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

  </div>
</BaseLayout>
