---
// ─────────────────────────────────────────────────────────────────────────────
// AdvisingGuide: the whole academic-advising page for one season.
//
// Used by src/pages/advising/index.astro (the current season) and
// src/pages/advising/[season].astro (every season, including past ones).
// All words, dates and links come from the season file; all course facts come
// from the catalog file the season names. Nothing here is semester-specific.
//
// Sections: hero + booking card · Prepare · Key dates · Course maps · Core · Help
//
// The course map is drawn in the browser (it needs real box positions for the
// arrows), so the catalog is handed to the inline script with define:vars.
// ─────────────────────────────────────────────────────────────────────────────
import type { Season, Catalog } from '../../lib/advising';

interface Props {
  season: Season;
  catalog: Catalog;
  /** Shown above the hero, e.g. the "archived" or "draft" notice. */
  banner?: { kind: 'archive' | 'draft'; html: string };
}
const { season, catalog, banner } = Astro.props;

const programs = Object.entries(catalog.programs).map(([id, p]) => ({ id, name: p.name }));
const coverLabel = { yes: 'Covered', part: 'Can be', no: 'Open' } as const;
---

<div class="adv">

  {banner && <div class={`adv-banner ${banner.kind}`} set:html={banner.html} />}

  <nav class="adv-nav" aria-label="Sections">
    <a href="#prepare">Prepare</a>
    <a href="#dates">Dates</a>
    <a href="#maps">Course maps</a>
    <a href="#core">Core</a>
    <a href="#help">Help</a>
  </nav>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <header class="adv-hero" id="top">
    <div>
      <div class="eyebrow">{season.hero.eyebrow}</div>
      <h1>{season.hero.title} <span>{season.hero.titleAccent}</span></h1>
      <p>{season.hero.intro}</p>
    </div>
    <aside class="book" aria-label="Book a meeting">
      <a class="btn" href={season.booking.url}>{season.booking.label}</a>
      <dl>
        {season.booking.details.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      </dl>
    </aside>
  </header>

  <!-- ── Prepare ──────────────────────────────────────────── -->
  <section id="prepare">
    <div class="read">
      <div class="eyebrow">Before we meet</div>
      <h2>{season.prepare.title}</h2>
      <div class="rule"><strong>{season.prepare.rule}</strong>{season.prepare.ruleText}</div>
      <ol class="steps">
        {season.prepare.steps.map((s) => (
          <li><div>
            <Fragment set:html={s.titleHtml} />
            <div class="links">{s.links.map(([label, url]) => <a href={url}>{label}</a>)}</div>
          </div></li>
        ))}
      </ol>
      <p>{season.prepare.after}</p>
    </div>
  </section>

  <!-- ── Key dates ────────────────────────────────────────── -->
  <section id="dates">
    <div class="eyebrow">{season.dates.eyebrow}</div>
    <h2>Key dates</h2>
    <div class="two">
      <div class="tbl">
        <table>
          <thead><tr><th>Class</th><th>Registration opens</th></tr></thead>
          <tbody>{season.dates.registration.map(([who, when]) => <tr><td>{who}</td><td class="num">{when}</td></tr>)}</tbody>
        </table>
        <p class="note" set:html={season.dates.registrationNoteHtml} />
      </div>
      <div class="tbl">
        <table>
          <thead><tr><th>Date</th><th>What</th></tr></thead>
          <tbody>{season.dates.events.map(([when, what]) => <tr><td class="num">{when}</td><td>{what}</td></tr>)}</tbody>
        </table>
        <p class="note" set:html={season.dates.eventsNoteHtml} />
      </div>
    </div>
  </section>

  <!-- ── Course maps (filled in by the script below) ──────── -->
  <section id="maps">
    <div class="read">
      <div class="eyebrow">{catalog.label}</div>
      <h2>Course maps</h2>
      <p>Each column is a semester. Colors show the year a course is usually taken; arrows point from a prerequisite to the course that needs it. Click or tap a course to see its details and highlight its prerequisite chain.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Program">
      {programs.map((p, i) => (
        <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-p={p.id}>{p.name}</button>
      ))}
    </div>
    <div class="controls">
      <div class="legend" aria-label="Legend">
        <span style="color:var(--y1)"><i></i>Year 1</span><span style="color:var(--y2)"><i></i>Year 2</span>
        <span style="color:var(--y3)"><i></i>Year 3</span><span style="color:var(--y4)"><i></i>Year 4</span>
        <span><i class="solid"></i>required prerequisite</span><span><i class="dash"></i>one of several options</span>
      </div>
      <label class="toggle"><input type="checkbox" id="adv-show-electives" /> Show individual electives</label>
    </div>
    <div class="mapbox"><div class="map" id="adv-map"><noscript><p class="note" style="padding:12px">The course map needs JavaScript. The requirement lists below and the catalog links in Help have the same information.</p></noscript></div></div>
    <div class="detail" id="adv-detail" aria-live="polite">Click a course to see its credits, when it is offered, and its prerequisites.</div>
    <p class="note" id="adv-mapnote"></p>
    <div class="reqs" id="adv-reqs"></div>
  </section>

  <!-- ── Core ─────────────────────────────────────────────── -->
  <section id="core">
    <div class="read">
      <div class="eyebrow">Calvin Core · {catalog.label}</div>
      <h2>Core requirements and what your major already covers</h2>
      <p>Every Calvin student completes the same core. Some courses required by your major also count toward the core; the table shows where that happens. Check your Academic Progress in Workday for your own record, since transfer and AP credit can change the picture.</p>
    </div>
    <div class="tbl">
      <table>
        <thead><tr><th>Core requirement</th><th>What it asks</th><th>BCS</th><th>CS Plus</th><th>Data Science</th></tr></thead>
        <tbody>
          {catalog.core.map((r) => (
            <tr>
              <td><b>{r.requirement}</b>{r.isNew && <> <span class="new">NEW</span></>}</td>
              <td>{r.asks}</td>
              {[r.bcs, r.plus, r.ds].map((c) => (
                <td><span class={`cover ${c.status}`}>{coverLabel[c.status]}</span>{c.courses && <><br /><span class="note">{c.courses}</span></>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note"><span class="cover yes">Covered</span> a required course in the major counts. <span class="cover part">Can be</span> a course in the major's options counts if you choose it. <span class="cover no">Open</span> take a course from the core list. Full lists: <a href={catalog.catalogUrl}>Core Program in the catalog</a>.</p>
  </section>

  <!-- ── Help ─────────────────────────────────────────────── -->
  <section id="help">
    <div class="eyebrow">Help</div>
    <h2>Where to get help</h2>
    <div class="two">
      {season.help.map((col) => <ul>{col.map((item) => <li set:html={item} />)}</ul>)}
    </div>
  </section>

  <p class="adv-foot">{catalog.sourceNote} Page updated {season.updated}.</p>
</div>

<script is:inline define:vars={{ catalog }}>
  // ── Course map ─────────────────────────────────────────────────────────────
  // Eight columns (Year 1 Fall … Year 4 Spring). Each program in the catalog
  // lists its nodes (course id + column), prerequisite edges, and optional
  // electives that appear when "Show individual electives" is ticked.
  // Node ids ending in "*" stand for "this course or an alternative"; the
  // catalog's `aliases` maps them back to the real course for its details.
  // Arrows are SVG paths measured from the rendered boxes, so they are redrawn
  // on resize, when fonts load, and when the site theme changes.
  const COLS = ['Year 1 · Fall','Year 1 · Spring','Year 2 · Fall','Year 2 · Spring','Year 3 · Fall','Year 3 · Spring','Year 4 · Fall','Year 4 · Spring'];
  const YC = ['--y1','--y1','--y2','--y2','--y3','--y3','--y4','--y4'];
  const C = catalog.courses, ALT = catalog.aliases, P = catalog.programs, GROUP_INFO = catalog.groupInfo;
  const DEFAULT_DETAIL = 'Click a course to see its credits, when it is offered, and its prerequisites.';

  const map = document.getElementById('adv-map'), detail = document.getElementById('adv-detail');
  const toggle = document.getElementById('adv-show-electives');
  const tabs = document.querySelectorAll('.adv .tabs button');
  let cur = Object.keys(P)[0], edgesNow = [], selected = null;
  const key = (id) => ALT[id] || id;
  const sid = (id) => 'n-' + id.replace(/[^A-Za-z0-9]/g, '_');
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function render() {
    const p = P[cur];
    const nodes = p.nodes.map((n) => ({ ...n, kind: n.kind || '' }));
    const edges = p.edges.map((e) => ({ a: e.from, b: e.to, or: !!e.or }));
    if (toggle.checked) {
      const have = new Set(nodes.map((n) => n.id));
      p.electives.forEach(({ id, col }) => { if (!have.has(id)) { nodes.push({ id, col, kind: 'elective' }); have.add(id); } });
      // An elective edge may name "CS 108" while the map shows "CS 108*".
      const res = (x) => have.has(x) ? x : ([...have].find((h) => key(h) === x) || null);
      p.electiveEdges.forEach((e) => { const a = res(e.from), b = res(e.to); if (a && b) edges.push({ a, b, or: !!e.or }); });
    }
    edgesNow = edges;
    map.innerHTML = '<svg class="edges" aria-hidden="true"></svg>';
    for (let c = 0; c < 8; c++) {
      const col = document.createElement('div');
      col.className = 'col'; col.style.color = `var(${YC[c]})`;
      col.innerHTML = `<div class="colhead">${COLS[c]}</div>`;
      nodes.filter((n) => n.col === c).forEach((n) => {
        const info = C[key(n.id)], b = document.createElement('button');
        b.className = 'node ' + n.kind; b.id = sid(n.id); b.dataset.id = n.id;
        b.style.setProperty('--yc', `var(${YC[c]})`);
        b.innerHTML = n.kind === 'group'
          ? `<span class="t"><b>${esc(n.label)}</b></span>`
          : `<span class="c">${esc(n.label || n.id)}</span><span class="t">${info ? esc(info.title) : ''}</span><span class="h">${info ? esc(info.credits) + ' cr' : ''}</span>`;
        b.addEventListener('click', () => select(n.id));
        col.appendChild(b);
      });
      map.appendChild(col);
    }
    document.getElementById('adv-mapnote').innerHTML = `${esc(p.note)} ${esc(p.hours)}. <a href="${esc(p.link.url)}">${esc(p.link.label)}</a>`;
    document.getElementById('adv-reqs').innerHTML = p.requirements
      .map((r) => `<div><h3>${esc(r.heading)}</h3><ul>${r.items.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`).join('');
    selected = null; map.classList.remove('focus'); detail.textContent = DEFAULT_DETAIL;
    requestAnimationFrame(draw);
  }

  function draw() {
    const svg = map.querySelector('svg'); if (!svg) return;
    const mr = map.getBoundingClientRect();
    const ink = getComputedStyle(map).getPropertyValue('--adv-arrow').trim();
    svg.setAttribute('width', map.scrollWidth); svg.setAttribute('height', map.scrollHeight);
    svg.innerHTML = `<defs><marker id="adv-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="${ink}"/></marker></defs>`;
    edgesNow.forEach((e) => {
      const A = document.getElementById(sid(e.a)), B = document.getElementById(sid(e.b)); if (!A || !B) return;
      const a = A.getBoundingClientRect(), b = B.getBoundingClientRect();
      let d;
      if (Math.abs(a.left - b.left) < 5) {
        // Same semester (e.g. CS 375 → CS 376): hook down the right-hand side.
        const x = a.right - mr.left, y1 = a.top + a.height / 2 - mr.top, y2 = b.top + b.height / 2 - mr.top;
        d = `M${x},${y1} C${x + 22},${y1} ${x + 22},${y2} ${x + 2},${y2}`;
      } else {
        // Straight stubs at both ends keep the arrowhead flat against the box at any angle.
        const x1 = a.right - mr.left, y1 = a.top + a.height / 2 - mr.top, x2 = b.left - mr.left - 2, y2 = b.top + b.height / 2 - mr.top;
        const s1 = x1 + 8, s2 = x2 - 10, dx = Math.max(12, (s2 - s1) / 2);
        d = `M${x1},${y1} L${s1},${y1} C${s1 + dx},${y1} ${s2 - dx},${y2} ${s2},${y2} L${x2},${y2}`;
      }
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', d); p.setAttribute('fill', 'none'); p.setAttribute('stroke', ink);
      p.setAttribute('stroke-width', '1.5'); p.setAttribute('marker-end', 'url(#adv-ah)');
      if (e.or) p.setAttribute('stroke-dasharray', '5 4');
      p.dataset.a = e.a; p.dataset.b = e.b; svg.appendChild(p);
    });
    if (selected) highlight(selected);
  }

  // Everything upstream (prerequisites) and downstream (courses it unlocks).
  function chain(id) {
    const up = new Set([id]), down = new Set([id]); let changed = true;
    while (changed) {
      changed = false;
      edgesNow.forEach((e) => {
        if (up.has(e.b) && !up.has(e.a)) { up.add(e.a); changed = true; }
        if (down.has(e.a) && !down.has(e.b)) { down.add(e.b); changed = true; }
      });
    }
    return { up, down };
  }
  function highlight(id) {
    const { up, down } = chain(id); map.classList.add('focus');
    map.querySelectorAll('.node').forEach((n) => n.classList.toggle('on', up.has(n.dataset.id) || down.has(n.dataset.id)));
    // Only the connector paths fade; the arrowhead marker path has no data-a.
    map.querySelectorAll('path[data-a]').forEach((p) => p.classList.toggle('on',
      (up.has(p.dataset.a) && up.has(p.dataset.b)) || (down.has(p.dataset.a) && down.has(p.dataset.b))));
  }
  function select(id) {
    if (selected === id) { selected = null; map.classList.remove('focus'); return; }
    selected = id; highlight(id);
    const n = [...P[cur].nodes, ...P[cur].electives].find((x) => x.id === id) || {};
    if (GROUP_INFO[id]) { detail.innerHTML = `<b>${esc(n.label)}</b><br>${esc(GROUP_INFO[id])}`; return; }
    const info = C[key(id)];
    detail.innerHTML = `<b>${esc(n.label || id)}</b> · ${esc(info.title)} · ${esc(info.credits)} credits · Offered: ${esc(info.offered)}<br>Prerequisites: ${esc(info.prereqs)}`;
  }

  tabs.forEach((b) => b.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));
    cur = b.dataset.p; try { localStorage.setItem('advTab', cur); } catch (e) {}
    render();
  }));
  toggle.addEventListener('change', render);
  try {
    const t = localStorage.getItem('advTab');
    if (t && P[t]) { cur = t; tabs.forEach((x) => x.setAttribute('aria-selected', x.dataset.p === t ? 'true' : 'false')); }
  } catch (e) {}
  render();
  window.addEventListener('resize', () => requestAnimationFrame(draw));
  if (document.fonts) document.fonts.ready.then(() => requestAnimationFrame(draw));
  // The navbar's theme button flips <html data-theme>; arrow colors follow it.
  new MutationObserver(() => requestAnimationFrame(draw))
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style is:global>
  /* ── Academic advising guide ───────────────────────────────────────────────
     Everything is scoped under .adv so it cannot leak into other pages.
     Colors build on the site tokens in global.css (dark by default, light via
     [data-theme="light"]); the four year hues are added here. */
  .adv {
    --y1: #5cc0d2; --y2: #e2b33c; --y3: #ef8a5e; --y4: #97a0f0;
    --gold: #e2b850; --gold-soft: #2a2416;
    --accent-ink: #120508;
    --adv-arrow: #8a8a8a;
    font-weight: 400;
  }
  [data-theme="light"] .adv {
    --y1: #1d7586; --y2: #a87a06; --y3: #bb4f27; --y4: #4a54a6;
    --gold: #9c7414; --gold-soft: #f6ecd2;
    --accent-ink: #ffffff;
    --adv-arrow: #77727c;
  }
  .adv a:focus-visible, .adv button:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; border-radius: 3px; }
  .adv h2 { font-size: 1.7rem; color: var(--text); border: 0; padding: 0; margin: 0 0 .4rem; letter-spacing: -0.015em; }
  .adv h3 { font-size: 1rem; }
  .adv .read { max-width: 68ch; }
  .adv .eyebrow { font-family: var(--mono); text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; color: var(--gold); margin-bottom: .4rem; }
  .adv section { padding: 40px 0 8px; border-top: 1px solid var(--border-mid); scroll-margin-top: 72px; }
  .adv p { margin-bottom: .8rem; }
  .adv ul { padding-left: 1.2rem; }

  .adv-banner { margin: 28px 0 0; padding: 12px 16px; border: 1px solid var(--border-mid); border-left: 4px solid var(--gold); background: var(--bg-card); font-size: .95rem; }
  .adv-banner.draft { border-left-color: var(--accent); }

  .adv-nav { display: flex; flex-wrap: wrap; gap: 4px 20px; padding: 18px 0 0; font-family: var(--mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
  .adv-nav a { color: var(--text-muted); }
  .adv-nav a:hover { color: var(--accent); opacity: 1; }

  /* hero */
  .adv .adv-hero { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: end; padding: 32px 0 32px; }
  .adv .adv-hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
  .adv .adv-hero h1 span { color: var(--accent); }
  .adv .adv-hero p { margin: .8rem 0 0; color: var(--text-muted); max-width: 52ch; }
  .adv .book { background: var(--bg-card); border: 1px solid var(--border-mid); border-top: 4px solid var(--accent); padding: 18px 20px; display: grid; gap: 12px; }
  .adv .btn { display: block; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 1.05rem; padding: 10px 18px; border-radius: 4px; text-align: center; }
  .adv .btn:hover { opacity: .88; }
  .adv .book dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: .92rem; }
  .adv .book dt { color: var(--text-muted); }
  .adv .book dd { font-weight: 600; }

  /* rule + steps */
  .adv .rule { background: var(--gold-soft); border-left: 4px solid var(--gold); padding: 14px 18px; margin-top: 10px; }
  .adv .rule strong { display: block; font-size: 1.1rem; margin-bottom: 2px; }
  .adv ol.steps { list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 14px; counter-reset: s; }
  .adv ol.steps li { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 10px; counter-increment: s; }
  .adv ol.steps li::before { content: counter(s); font-family: var(--mono); font-weight: 500; color: var(--accent-ink); background: var(--accent); width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center; }
  .adv ol.steps .links { font-size: .9rem; display: flex; flex-wrap: wrap; gap: 2px 14px; }

  /* tables */
  .adv .tbl { overflow-x: auto; }
  .adv table { border-collapse: collapse; width: 100%; font-size: .93rem; line-height: 1.45; }
  .adv th, .adv td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border-mid); vertical-align: top; }
  .adv th { font-family: var(--mono); font-weight: 500; font-size: .72rem; letter-spacing: .08em; color: var(--text-muted); text-transform: uppercase; }
  .adv td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .adv .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; margin-top: 16px; }
  .adv .note { color: var(--text-muted); font-size: .88rem; margin-top: .6rem; }

  /* course map */
  .adv .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 18px 0 10px; }
  .adv .tabs button { font-weight: 500; font-size: .95rem; padding: 6px 14px; border: 1px solid var(--border-mid); background: var(--bg-card); color: var(--text); border-radius: 4px; }
  .adv .tabs button[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .adv .controls { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: center; font-size: .88rem; color: var(--text-muted); margin-bottom: 10px; }
  .adv .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .adv .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .adv .legend i { width: 14px; height: 14px; border-radius: 3px; border: 2px solid currentColor; display: inline-block; }
  .adv .legend .dash { width: 26px; height: 0; border: 0; border-top: 2px dashed var(--text-muted); border-radius: 0; }
  .adv .legend .solid { width: 26px; height: 0; border: 0; border-top: 2px solid var(--text-muted); border-radius: 0; }
  .adv label.toggle { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; color: var(--text); }
  .adv .mapbox { overflow-x: auto; background: var(--bg-card); border: 1px solid var(--border-mid); border-radius: 6px; }
  .adv .map { position: relative; display: grid; grid-template-columns: repeat(8, 158px); column-gap: 56px; padding: 12px 18px 18px; width: max-content; }
  .adv .map svg.edges { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .adv .colhead { font-family: var(--mono); font-weight: 500; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; padding: 6px 0 8px; border-bottom: 3px solid currentColor; margin-bottom: 10px; }
  .adv .col { display: flex; flex-direction: column; gap: 12px; }
  .adv .node { position: relative; z-index: 1; background: color-mix(in srgb, var(--yc) 12%, var(--bg-card)); border: 2px solid var(--yc); border-radius: 6px; padding: 6px 8px; text-align: left; color: var(--text); font: inherit; line-height: 1.3; width: 100%; transition: opacity .15s; }
  .adv .node .c { font-family: var(--mono); font-weight: 500; font-size: .78rem; color: var(--yc); }
  .adv .node .t { display: block; font-size: .8rem; line-height: 1.25; }
  .adv .node .h { font-family: var(--mono); font-size: .68rem; color: var(--text-muted); }
  .adv .node.group { border-style: dashed; background: var(--bg-card); }
  .adv .node.elective { border-style: dotted; }
  .adv .map.focus .node { opacity: .28; }
  .adv .map.focus .node.on { opacity: 1; }
  .adv .map.focus path[data-a] { opacity: .12; }
  .adv .map.focus path[data-a].on { opacity: 1; stroke-width: 2.6; }
