---
// ─────────────────────────────────────────────────────────────────────────────
// AdvisingGuide: the whole academic-advising page for one season.
//
// Used by src/pages/advising/index.astro (the current season) and
// src/pages/advising/[season].astro (every season, including past ones).
// All words, dates and links come from the season file; all course facts come
// from the catalog file the season names. Nothing here is semester-specific.
//
// Sections: hero + booking card · Prepare · Key dates · Course maps · Core · Help
//
// The course map is drawn in the browser (it needs real box positions for the
// arrows), so the catalog is handed to the inline script with define:vars.
// ─────────────────────────────────────────────────────────────────────────────
import type { Season, Catalog } from '../../lib/advising';

interface Props {
  season: Season;
  catalog: Catalog;
  /** Shown above the hero, e.g. the "archived" or "draft" notice. */
  banner?: { kind: 'archive' | 'draft'; html: string };
}
const { season, catalog, banner } = Astro.props;

const programs = Object.entries(catalog.programs).map(([id, p]) => ({ id, name: p.name }));
const coverLabel = { yes: 'Covered', part: 'Can be', no: 'Open' } as const;
---

<div class="adv">

  <!-- Corner ribbon: this guide is Eric's own summary, not an official
       Calvin document. The catalog and Workday are the official sources. -->
  <div class="adv-ribbon-wrap" aria-hidden="true"><div class="adv-ribbon">Unofficial document</div></div>
  <p class="sr-only">This is an unofficial advising guide. The Calvin catalog and Workday are the official sources.</p>

  {banner && <div class={`adv-banner ${banner.kind}`} set:html={banner.html} />}

  <nav class="adv-nav" aria-label="Sections">
    <a href="#prepare">Prepare</a>
    <a href="#dates">Dates</a>
    <a href="#maps">Course maps</a>
    <a href="#addons">Minors</a>
    <a href="#core">Core</a>
    <a href="#help">Help</a>
  </nav>

  <!-- ── Title + TL;DR ───────────────────────────────────────
       One column on purpose: title, the short version, then the booking
       button. Everything after this is the long version. -->
  <header class="adv-hero" id="top">
    <h1>{season.hero.title}</h1>
    <h2 class="tldr-head">TL;DR</h2>
    <ul class="tldr">
      {season.hero.tldrHtml.map((item) => <li set:html={item} />)}
    </ul>
    <a class="btn book-btn" href={season.booking.url}>{season.booking.label}</a>
  </header>

  <!-- ── Prepare ──────────────────────────────────────────── -->
  <section id="prepare">
    <div class="read">
      <div class="eyebrow">Before we meet</div>
      <h2>{season.prepare.title}</h2>
      <div class="rule"><strong>{season.prepare.rule}</strong>{season.prepare.ruleText}</div>
      <ol class="steps">
        {season.prepare.steps.map((s) => (
          <li><div>
            <Fragment set:html={s.titleHtml} />
            <div class="links">{s.links.map(([label, url]) => <a href={url}>{label}</a>)}</div>
          </div></li>
        ))}
      </ol>
      <p>{season.prepare.after}</p>
    </div>
  </section>

  <!-- ── Key dates ────────────────────────────────────────── -->
  <section id="dates">
    <div class="eyebrow">{season.dates.eyebrow}</div>
    <h2>Key dates</h2>
    <div class="two">
      <div class="tbl">
        <table>
          <thead><tr><th>Class</th><th>Registration opens</th></tr></thead>
          <tbody>{season.dates.registration.map(([who, when]) => <tr><td>{who}</td><td class="num">{when}</td></tr>)}</tbody>
        </table>
        <p class="note" set:html={season.dates.registrationNoteHtml} />
      </div>
      <div class="tbl">
        <table>
          <thead><tr><th>Date</th><th>What</th></tr></thead>
          <tbody>{season.dates.events.map(([when, what]) => <tr><td class="num">{when}</td><td>{what}</td></tr>)}</tbody>
        </table>
        <p class="note" set:html={season.dates.eventsNoteHtml} />
      </div>
    </div>
  </section>

  <!-- ── Course maps (filled in by the script below) ──────── -->
  <section id="maps">
    <div class="read">
      <div class="eyebrow">{catalog.label}</div>
      <h2>Course maps</h2>
      <p>Each row is a semester. Arrows go from a prerequisite to the course that needs it. Click a course for its description and prerequisites.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Program">
      {programs.map((p, i) => (
        <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-p={p.id}>{p.name}</button>
      ))}
    </div>
    <div class="controls">
      <div class="legend" aria-label="Legend">
        <span style="color:var(--y1)"><i></i>Year 1</span><span style="color:var(--y2)"><i></i>Year 2</span>
        <span style="color:var(--y3)"><i></i>Year 3</span><span style="color:var(--y4)"><i></i>Year 4</span>
        <span><i class="solid"></i>required prerequisite</span><span><i class="dash"></i>one of several options</span>
        {season.nextTerm && <span><b class="next">{season.nextTerm.term}</b> has sections next term</span>}
      </div>
      <label class="toggle"><input type="checkbox" id="adv-show-electives" /> Show individual electives</label>
    </div>
    <div class="mapbox"><div class="map" id="adv-map"><noscript><p class="note" style="padding:12px">The course map needs JavaScript. The requirement lists below and the catalog links in Help have the same information.</p></noscript></div></div>
    <p class="note" id="adv-narrow" hidden>On a small screen the arrows are hidden. Tap a course to highlight its prerequisites and the courses it leads to.</p>
    <div class="detail" id="adv-detail" aria-live="polite">Click a course to see its credits, when it is offered and its prerequisites.</div>
    <p class="note" id="adv-mapnote"></p>
    {season.nextTerm && (
      <p class="note">
        The {season.nextTerm.term} tags come from <a href={season.nextTerm.sourceUrl}>{season.nextTerm.sourceLabel}</a> (checked {season.nextTerm.checked}) and match the catalog.
        A tag marked <b class="next unofficial">(unofficial)</b> appears only on his list: the catalog says the course runs in alternate years or varies, so confirm it in Workday.
      </p>
    )}
    <div class="reqs" id="adv-reqs"></div>
  </section>

  <!-- ── Minors and certificates (from the catalog file) ──── -->
  {catalog.addOns && (
    <section id="addons">
      <div class="read">
        <h2>Minors and certificates</h2>
        {catalog.addOns.intro && <p>{catalog.addOns.intro}</p>}
        <ul>
          {catalog.addOns.items.map((it) => <li>{it.for && <b>{it.for}: </b>}<Fragment set:html={it.html} /></li>)}
        </ul>
        {catalog.addOns.moreHtml && <p class="note" set:html={catalog.addOns.moreHtml} />}
      </div>
    </section>
  )}

  <!-- ── Core ─────────────────────────────────────────────── -->
  <section id="core">
    <div class="read">
      <div class="eyebrow">{catalog.label}</div>
      <h2>Core requirements</h2>
      <p>Some courses in your major also count for the core. Check your Academic Progress in Workday to see what you still need.</p>
    </div>
    <div class="tbl">
      <table>
        <thead><tr><th>Core requirement</th><th>What it asks</th><th>BCS</th><th>CS Plus</th><th>Data Science</th></tr></thead>
        <tbody>
          {catalog.core.map((r) => (
            <tr>
              <td><b>{r.requirement}</b>{r.isNew && <> <span class="new">NEW</span></>}</td>
              <td>{r.asks}</td>
              {[r.bcs, r.plus, r.ds].map((c) => (
                <td><span class={`cover ${c.status}`}>{coverLabel[c.status]}</span>{c.courses && <><br /><span class="note">{c.courses}</span></>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note"><span class="cover yes">Covered</span> means a required course in your major counts. <span class="cover part">Can be</span> means one of the options in your major counts if you pick it. <span class="cover no">Open</span> means you take a course from the core list. Full lists: <a href={catalog.catalogUrl}>Core Program in the catalog</a>.</p>
  </section>

  <!-- ── Help ─────────────────────────────────────────────── -->
  <section id="help">
        <h2>Help</h2>
    <div class="two">
      {season.help.map((col) => <ul>{col.map((item) => <li set:html={item} />)}</ul>)}
    </div>
  </section>

  <p class="adv-foot">{catalog.sourceNote} Page updated {season.updated}.</p>
</div>

<script is:inline define:vars={{ catalog, nextTerm: season.nextTerm ?? null }}>
  // ── Course map ─────────────────────────────────────────────────────────────
  // The map reads top to bottom: one row per semester (Year 1 Fall at the top,
  // Year 4 Spring at the bottom), courses side by side inside each row.
  //
  // Data: each program in the catalog lists its nodes (course id + `col`,
  // where col 0..7 is the semester row), prerequisite edges, and optional
  // electives that appear when "Show individual electives" is ticked.
  // Node ids ending in "*" stand for "this course or an alternative"; the
  // catalog's `aliases` maps them back to the real course for its details.
  //
  // Arrows are SVG paths measured from the rendered boxes, so they are redrawn
  // on resize, when fonts load, and when the site theme changes. An arrow
  // leaves the bottom of the prerequisite and enters the top of the course
  // that needs it. When two courses in the same semester depend on each other
  // (MATH 251 → MATH 252, CS 375 → CS 376) the arrow runs sideways instead.
  const ROWS = ['Year 1 Fall','Year 1 Spring','Year 2 Fall','Year 2 Spring','Year 3 Fall','Year 3 Spring','Year 4 Fall','Year 4 Spring'];
  const YC = ['--y1','--y1','--y2','--y2','--y3','--y3','--y4','--y4'];
  const C = catalog.courses, ALT = catalog.aliases, P = catalog.programs, GROUP_INFO = catalog.groupInfo;
  // Courses with sections next term (an unofficial list kept in the season
  // file). A node label such as "STAT 143/145/243" or "CS 108 / 106" stands
  // for several courses, so every code in the label is checked.
  const NEXT = new Set(nextTerm ? nextTerm.courses : []);
  function codesIn(n) {
    const codes = [key(n.id)];
    const m = (n.label || '').match(/^([A-Z]{2,4})\s(\d{3})((?:\s?\/\s?\d{3})*)/);
    if (m) { codes.push(`${m[1]} ${m[2]}`); (m[3].match(/\d{3}/g) || []).forEach((d) => codes.push(`${m[1]} ${d}`)); }
    return codes;
  }
  const runsNext = (n) => n.kind !== 'group' && codesIn(n).some((c) => NEXT.has(c));
  // The tag is "confirmed" when the official catalog agrees: the course is
  // listed as running every term of that kind (e.g. "Spring", "Fall, Spring").
  // Alternate-year, select-year, "varies" and "as needed" courses cannot be
  // confirmed that way, so for those the tag says "(unofficial)".
  const season = nextTerm ? nextTerm.term.split(' ')[0] : '';
  const confirmedBy = (code) => {
    const off = (C[code] || {}).offered || '';
    return new RegExp(season, 'i').test(off) && !/alternate|select|varies|as needed/i.test(off);
  };
  const confirmedNext = (n) => codesIn(n).some((c) => NEXT.has(c) && confirmedBy(c));
  const nextTag = (n) => confirmedNext(n)
    ? `<span class="next">${esc(nextTerm.term)}</span>`
    : `<span class="next unofficial">${esc(nextTerm.term)} (unofficial)</span>`;
  const DEFAULT_DETAIL = 'Click a course to see its credits, when it is offered and its prerequisites.';

  const map = document.getElementById('adv-map'), detail = document.getElementById('adv-detail');
  const toggle = document.getElementById('adv-show-electives');
  const tabs = document.querySelectorAll('.adv .tabs button');
  let cur = Object.keys(P)[0], edgesNow = [], selected = null;
  const key = (id) => ALT[id] || id;
  const sid = (id) => 'n-' + id.replace(/[^A-Za-z0-9]/g, '_');
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  // Put each course roughly under its prerequisites so arrows cross less.
  // Row by row, a course's sort key is the average position (0..1) of its
  // prerequisites in earlier rows; courses without one keep their place in
  // the data. This is the classic "barycenter" trick for layered graphs.
  function orderRows(nodes, edges) {
    const pos = {}, rows = [];
    for (let r = 0; r < 8; r++) {
      const row = nodes.filter((n) => n.col === r);
      const keyed = row.map((n, i) => {
        const preds = edges.filter((e) => e.b === n.id && pos[e.a] !== undefined).map((e) => pos[e.a]);
        const k = preds.length ? preds.reduce((x, y) => x + y, 0) / preds.length : (i + 0.5) / row.length;
        return { n, k, i };
      }).sort((x, y) => x.k - y.k || x.i - y.i);
      keyed.forEach((x, i) => { pos[x.n.id] = (i + 0.5) / keyed.length; });
      rows.push(keyed.map((x) => x.n));
    }
    return rows;
  }

  function render() {
    const p = P[cur];
    const nodes = p.nodes.map((n) => ({ ...n, kind: n.kind || '' }));
    const edges = p.edges.map((e) => ({ a: e.from, b: e.to, or: !!e.or }));
    if (toggle.checked) {
      const have = new Set(nodes.map((n) => n.id));
      p.electives.forEach(({ id, col }) => { if (!have.has(id)) { nodes.push({ id, col, kind: 'elective' }); have.add(id); } });
      // An elective edge may name "CS 108" while the map shows "CS 108*".
      const res = (x) => have.has(x) ? x : ([...have].find((h) => key(h) === x) || null);
      p.electiveEdges.forEach((e) => { const a = res(e.from), b = res(e.to); if (a && b) edges.push({ a, b, or: !!e.or }); });
    }
    edgesNow = edges;
    map.innerHTML = '<svg class="edges" aria-hidden="true"></svg>';
    orderRows(nodes, edges).forEach((rowNodes, r) => {
      const head = document.createElement('div');
      head.className = 'rowhead'; head.style.color = `var(${YC[r]})`; head.textContent = ROWS[r];
      const row = document.createElement('div');
      row.className = 'row';
      rowNodes.forEach((n) => {
        const info = C[key(n.id)], b = document.createElement('button');
        b.className = 'node ' + n.kind; b.id = sid(n.id); b.dataset.id = n.id; b.dataset.row = r;
        b.style.setProperty('--yc', `var(${YC[r]})`);
        b.innerHTML = n.kind === 'group'
          ? `<span class="t"><b>${esc(n.label)}</b></span>`
          : `<span class="c">${esc(n.label || n.id)}</span><span class="t">${info ? esc(info.title) : ''}</span><span class="h">${info ? esc(info.credits) + ' cr' : ''}</span>`
            + (runsNext(n) ? nextTag(n) : '');
        b.addEventListener('click', () => select(n.id));
        row.appendChild(b);
      });
      map.append(head, row);
    });
    document.getElementById('adv-mapnote').innerHTML = `${esc(p.note)} ${esc(p.hours)}. <a href="${esc(p.link.url)}">${esc(p.link.label)}</a>`;
    document.getElementById('adv-reqs').innerHTML = p.requirements
      .map((r) => `<div><h3>${esc(r.heading)}</h3><ul>${r.items.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`).join('');
    selected = null; map.classList.remove('focus'); detail.textContent = DEFAULT_DETAIL;
    externalLinksInNewTab();
    requestAnimationFrame(draw);
  }

  function draw() {
    const svg = map.querySelector('svg'); if (!svg) return;
    const mr = map.getBoundingClientRect();
    const ink = getComputedStyle(map).getPropertyValue('--adv-arrow').trim();
    svg.setAttribute('width', map.scrollWidth); svg.setAttribute('height', map.scrollHeight);
    svg.innerHTML = '';
    // Arrowheads are drawn as their own small triangles rather than SVG
    // <marker>s. Markers scale with the line width (so highlighted arrows got
    // fat heads) and take their angle from the curve's last few pixels (so
    // heads on short or bent ends came out tilted). A hand-drawn head is
    // always the same size and always points straight into the box.
    const HEAD_L = 7, HEAD_W = 4; // length and half-width in px

    // Box positions relative to the map.
    const box = {};
    edgesNow.forEach((e) => [e.a, e.b].forEach((id) => {
      if (box[id]) return;
      const el = document.getElementById(sid(id)); if (!el) return;
      const r = el.getBoundingClientRect();
      box[id] = { row: +el.dataset.row, l: r.left - mr.left, r: r.right - mr.left, t: r.top - mr.top, b: r.bottom - mr.top, cx: (r.left + r.right) / 2 - mr.left, cy: (r.top + r.bottom) / 2 - mr.top };
    }));
    // On a phone the rows wrap onto several lines and the arrows turn into a
    // tangle, so they are not drawn there. Tapping a course still highlights
    // its whole prerequisite chain (that uses the data, not the drawn lines).
    const narrow = map.clientWidth < 560;
    document.getElementById('adv-narrow').hidden = !narrow;
    if (narrow) { if (selected) highlight(selected); return; }
    const live = edgesNow.filter((e) => box[e.a] && box[e.b]);
    const sameLine = (e) => Math.abs(box[e.a].t - box[e.b].t) < 5;

    // Several arrows can leave the bottom of one box (or enter the top of one
    // box). Spread their end points across the edge, ordered by where the
    // other end is, so they do not pile up on the centre and cross needlessly.
    const slot = (list, sideBox, otherX) => {
      list.sort((x, y) => otherX(x) - otherX(y));
      const m = new Map();
      list.forEach((e, i) => m.set(e, sideBox.l + (sideBox.r - sideBox.l) * (i + 1) / (list.length + 1)));
      return m;
    };
    const outX = new Map(), inX = new Map();
    Object.keys(box).forEach((id) => {
      const outs = live.filter((e) => e.a === id && !sameLine(e));
      const ins = live.filter((e) => e.b === id && !sameLine(e));
      slot(outs, box[id], (e) => box[e.b].cx).forEach((x, e) => outX.set(e, x));
      slot(ins, box[id], (e) => box[e.a].cx).forEach((x, e) => inX.set(e, x));
    });

    // ── Routing arrows that skip a semester ──────────────────────────────────
    // An arrow from Year 1 Fall to Year 2 Spring would cut straight through
    // the boxes in the rows in between. Instead it travels in the empty space:
    // down into the gap under its own row, sideways to a vertical "channel"
    // (the gaps between box columns line up from row to row because every box
    // has the same width), down the channel, and sideways again in the gap
    // above the target row. Arrows sharing a channel or a gap are nudged a few
    // pixels apart so they stay distinguishable.
    const rowEls = [...map.querySelectorAll('.row')].map((el) => el.getBoundingClientRect());
    const gapBelow = (r) => (rowEls[r].bottom + rowEls[r + 1].top) / 2 - mr.top;
    const lefts = [...new Set([...map.querySelectorAll('.node')].map((n) => Math.round(n.getBoundingClientRect().left - mr.left)))].sort((x, y) => x - y);
    const nodeW = map.querySelector('.node')?.getBoundingClientRect().width || 150;
    const channels = [lefts[0] - 7, ...lefts.slice(1).map((x) => x - 9), lefts[lefts.length - 1] + nodeW + 10];
    const used = {}; // how many arrows already run along a channel or gap
    const nudge = (k) => { used[k] = (used[k] || 0) + 1; const n = used[k] - 1; return n === 0 ? 0 : (n % 2 ? 1 : -1) * Math.ceil(n / 2) * 4; };
    // Polyline with softly rounded corners (radius 6px).
    const rounded = (pts) => {
      let d = `M${pts[0][0]},${pts[0][1]}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const [px, py] = pts[i - 1], [x, y] = pts[i], [nx, ny] = pts[i + 1];
        const r1 = Math.min(6, Math.hypot(x - px, y - py) / 2), r2 = Math.min(6, Math.hypot(nx - x, ny - y) / 2);
        const ax = x - Math.sign(x - px) * r1, ay = y - Math.sign(y - py) * r1;
        const bx = x + Math.sign(nx - x) * r2, by = y + Math.sign(ny - y) * r2;
        d += ` L${ax},${ay} Q${x},${y} ${bx},${by}`;
      }
      const last = pts[pts.length - 1];
      return d + ` L${last[0]},${last[1]}`;
    };

    const downHead = (x, tipY) => `M${x},${tipY} L${x - HEAD_W},${tipY - HEAD_L} L${x + HEAD_W},${tipY - HEAD_L} Z`;

    live.forEach((e) => {
      const A = box[e.a], B = box[e.b];
      let d, head;
      if (sameLine(e)) {
        // Same semester, side by side: short sideways arrow between the boxes.
        const right = B.l >= A.r;
        const x1 = right ? A.r : A.l, tipX = right ? B.l - 1 : B.r + 1;
        const baseX = tipX + (right ? -HEAD_L : HEAD_L);
        d = `M${x1},${A.cy} L${baseX},${B.cy}`;
        head = `M${tipX},${B.cy} L${baseX},${B.cy - HEAD_W} L${baseX},${B.cy + HEAD_W} Z`;
      } else if (B.row - A.row >= 2) {
        // Skips at least one semester: go around the boxes (see above).
        const x1 = outX.get(e), x2 = inX.get(e);
        const mid = (x1 + x2) / 2;
        const ci = channels.reduce((best, c, i) => Math.abs(c - mid) < Math.abs(channels[best] - mid) ? i : best, 0);
        const cx = channels[ci] + nudge('c' + ci);
        const y1 = gapBelow(A.row) + nudge('g' + A.row), y2 = gapBelow(B.row - 1) + nudge('g' + (B.row - 1));
        d = rounded([[x1, A.b], [x1, y1], [cx, y1], [cx, y2], [x2, y2], [x2, B.t - 1 - HEAD_L]]);
        head = downHead(x2, B.t - 1);
      } else {
        // Next semester: a smooth S-curve, with straight stubs at both ends so
        // the arrowhead always points straight down into the box.
        const x1 = outX.get(e), y1 = A.b, x2 = inX.get(e), y2 = B.t - 1 - HEAD_L;
        head = downHead(x2, B.t - 1);
        const s1 = y1 + 6, s2 = y2 - 8, dy = Math.max(10, (s2 - s1) / 2);
        d = `M${x1},${y1} L${x1},${s1} C${x1},${s1 + dy} ${x2},${s2 - dy} ${x2},${s2} L${x2},${y2}`;
      }
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', d); p.setAttribute('fill', 'none'); p.setAttribute('stroke', ink);
      p.setAttribute('stroke-width', '1.5');
      if (e.or) p.setAttribute('stroke-dasharray', '5 4');
      p.dataset.a = e.a; p.dataset.b = e.b; svg.appendChild(p);
      const h = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      h.setAttribute('d', head); h.setAttribute('fill', ink); h.setAttribute('class', 'head');
      h.dataset.a = e.a; h.dataset.b = e.b; svg.appendChild(h);
    });
    if (selected) highlight(selected);
  }

  // Everything upstream (prerequisites) and downstream (courses it unlocks).
  function chain(id) {
    const up = new Set([id]), down = new Set([id]); let changed = true;
    while (changed) {
      changed = false;
      edgesNow.forEach((e) => {
        if (up.has(e.b) && !up.has(e.a)) { up.add(e.a); changed = true; }
        if (down.has(e.a) && !down.has(e.b)) { down.add(e.b); changed = true; }
      });
    }
    return { up, down };
  }
  function highlight(id) {
    const { up, down } = chain(id); map.classList.add('focus');
    map.querySelectorAll('.node').forEach((n) => n.classList.toggle('on', up.has(n.dataset.id) || down.has(n.dataset.id)));
    // Lines and their heads both carry data-a/data-b, so they fade together.
    map.querySelectorAll('path[data-a]').forEach((p) => p.classList.toggle('on',
      (up.has(p.dataset.a) && up.has(p.dataset.b)) || (down.has(p.dataset.a) && down.has(p.dataset.b))));
  }
  function select(id) {
    if (selected === id) { selected = null; map.classList.remove('focus'); return; }
    selected = id; highlight(id);
    const n = [...P[cur].nodes, ...P[cur].electives].find((x) => x.id === id) || {};
    if (GROUP_INFO[id]) { detail.innerHTML = `<b>${esc(n.label)}</b><br>${esc(GROUP_INFO[id])}`; return; }
    const info = C[key(id)];
    // Title, then the catalog description, then the practical facts.
    const next = nextTerm
      ? (!runsNext({ ...n, id }) ? `<br>${esc(nextTerm.term)}: no sections listed.`
         : confirmedNext({ ...n, id }) ? `<br>${esc(nextTerm.term)}: has sections.`
         : `<br>${esc(nextTerm.term)}: has sections according to Prof. Arnold's list, but the catalog does not confirm it. Check Workday.`)
      : '';
    detail.innerHTML = `<b>${esc(n.label || id)}</b>: ${esc(info.title)}`
      + (info.description ? `<p class="desc">${esc(info.description)}</p>` : '<br>')
      + `${esc(info.credits)} credits. Offered: ${esc(info.offered)}.<br>Prerequisites: ${esc(info.prereqs)}${next}`;
  }

  // ── External links open in a new tab ───────────────────────────────────────
  // Any link to another site (Workday guides, the catalog, Bookings, Calvin
  // pages) gets target="_blank". rel="noopener" stops the new tab from being
  // able to control this one. Runs once for the static page and again after
  // each map render, because the program note link is created by render().
  function externalLinksInNewTab() {
    document.querySelectorAll('.adv a[href]').forEach((a) => {
      if (a.host && a.host !== location.host) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
    });
  }

  tabs.forEach((b) => b.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));
    cur = b.dataset.p; try { localStorage.setItem('advTab', cur); } catch (e) {}
    render();
  }));
  toggle.addEventListener('change', render);
  try {
    const t = localStorage.getItem('advTab');
    if (t && P[t]) { cur = t; tabs.forEach((x) => x.setAttribute('aria-selected', x.dataset.p === t ? 'true' : 'false')); }
  } catch (e) {}
  render();
  window.addEventListener('resize', () => requestAnimationFrame(draw));
  if (document.fonts) document.fonts.ready.then(() => requestAnimationFrame(draw));
  // The navbar's theme button flips <html data-theme>; arrow colors follow it.
  new MutationObserver(() => requestAnimationFrame(draw))
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

