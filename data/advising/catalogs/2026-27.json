    "ETH": "PHIL 205 Ethics or BUS 392 Business Ethics.",
    "MSEL": "4 hours from MATH 335, MATH 355, STAT 341, STAT 343, STAT 344 or STAT 385.",
    "BUS": "At least 6 hours from ACCT 315, BUS 100, BUS 201, BUS 310, BUS 311, COMM 362 or ENGL 241."
  },
